# Host port exposed by Docker Compose. The app binds to localhost by default so
# it must be reached through a reverse proxy; set PROJECT_HUB_BIND=0.0.0.0 only
# if you intentionally expose it on the LAN.
PROJECT_HUB_PORT=8080
PROJECT_HUB_BIND=127.0.0.1

# Optional host-side Git service. Leave blank to disable local Git inspection.
# The URL is reachable from the app container through host.docker.internal.
GIT_SERVICE_URL=http://host.docker.internal:8090
GIT_SERVICE_TOKEN=

# Optional GitHub API token for private repositories or higher rate limits.
# The token is sent to api.github.com ONLY for repos whose owner is listed in
# GITHUB_TOKEN_OWNERS (comma-separated, case-insensitive). Leave empty to never
# send the token — public repo data is still fetched anonymously.
GITHUB_TOKEN=
GITHUB_TOKEN_OWNERS=

# Set to 0 to disable public self-registration (recommended on shared/VPS
# deployments where accounts are created by the admin).
ALLOW_REGISTRATION=1

# Optional Authentik/OIDC configuration.
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=
